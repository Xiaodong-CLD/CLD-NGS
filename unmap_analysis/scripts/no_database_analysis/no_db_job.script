# Access command-line argument
arg1=$1

# Run unmap analysis
conda activate unmap_analysis
bash /mnt/efs/home/zds0975/pipeline_test/voof/unmap_analysis/scripts/no_database_analysis/no_db_unmap_analysis.sh $arg1


